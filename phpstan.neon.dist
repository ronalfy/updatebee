includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	treatPhpDocTypesAsCertain: false
	paths:
		- updatebee.php
		- includes
	excludePaths:
		- phpstan
	bootstrapFiles:
		- tests/php/phpstan-bootstrap.php

services:
	-
		class: UpdateBee\PHPStan\Rules\RequireAbspathGuardRule
		tags:
			- phpstan.rules.rule
