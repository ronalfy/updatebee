{
	"name": "updatebee",
	"version": "1.0.0",
	"description": "Take complete control over your automatic WordPress updates.",
	"author": "MediaRon LLC",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"composer:guard": "php bin/add-composer-guards.php",
		"assets:guard": "php bin/add-asset-guards.php",
		"i18n": "grunt i18n",
		"release": "grunt release",
		"compress": "grunt compress",
		"build": "wp-scripts build && npm run assets:guard && npm run composer:guard",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src/js",
		"lint:css": "wp-scripts lint-style src/scss",
		"test:js": "wp-scripts test-unit-js",
		"typecheck": "tsc --noEmit"
	},
	"prettier": "@wordpress/prettier-config",
	"devDependencies": {
		"@mediaron/react-spinners": "^0.1.4",
		"@types/jest": "^29.5.14",
		"@types/qs": "^6.14.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wordpress/scripts": "^37.1.0",
		"@wordpress/url": "^4.56.0",
		"eslint": "^10.15.0",
		"jsdom": "^26.1.0",
		"typescript": "^5.9.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@wordpress/components": "^40.1.0",
		"@wordpress/dataviews": "^19.0.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/i18n": "^6.12.0",
		"@wordpress/icons": "^16.0.0",
		"@wordpress/theme": "^2.1.0",
		"@wordpress/ui": "^0.22.0",
		"axios": "^1.12.2",
		"clsx": "^2.1.1",
		"grunt": "^1.6.3",
		"grunt-cli": "^1.5.0",
		"grunt-contrib-compress": "^2.0.0",
		"qs": "^6.14.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.62.0"
	}
}
